                    pass  # rotated away meanwhile
            for path, title, stat in files:
                view = Gtk.Button(label=tr("查看", "View"), css_classes=["compact-button"])
                view.connect("clicked", lambda _b, p=path, t=title: self.show_log(p, t))
                when = datetime.fromtimestamp(stat.st_mtime)
                self.log_list.append(settings_row(title, f"{human_size(stat.st_size)} · {when:%m-%d %H:%M}", view))
            if not files:
                self.log_list.append(settings_row(tr("还没有日志", "No logs yet"), None, Gtk.Box()))
            running = is_running()
            self.clear_logs_row.set_sensitive(bool(files) and not running)
