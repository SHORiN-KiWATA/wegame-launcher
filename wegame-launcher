def proton_log_settings(env, fresh_session):
    """Turn on Proton's own log (Wine debug output, DXVK/VKD3D messages) when
    the user asked for it."""
    config = load_config()
    if not config.get("proton_log"):
        return
    LOGS.mkdir(parents=True, exist_ok=True)
    if fresh_session:
        rotate_proton_log()
    env["PROTON_LOG"] = "1"
    env["PROTON_LOG_DIR"] = str(LOGS)
    if config.get("winedebug"):
        env["WINEDEBUG"] = config["winedebug"]


def rotate_proton_log():
    """Proton appends to steam-0.log; give each WeGame session its own file
    and keep only the last few, since a full Wine log can reach gigabytes."""
    if PROTON_LOG.is_file() and PROTON_LOG.stat().st_size:
        stamp = datetime.fromtimestamp(PROTON_LOG.stat().st_mtime)
        PROTON_LOG.rename(LOGS / f"steam-0.{stamp:%Y%m%d-%H%M%S}.log")
    for old in old_proton_logs()[KEEP_PROTON_LOGS:]:
        old.unlink(missing_ok=True)


def old_proton_logs():
    return sorted(LOGS.glob("steam-0.*.log"), reverse=True)  # names sort by time


def log_files():
    """(path, title) of every log, the most useful first."""
    named = [(PROTON_LOG, tr("Proton 日志", "Proton log")),
             (LOGS / "wegame.log", tr("WeGame 输出", "WeGame output")),
             (LOGS / "setup.log", tr("安装和初始化", "Install and setup"))]
    files = [(path, title) for path, title in named if path.is_file()]
    for path in old_proton_logs():
        match = re.fullmatch(r"steam-0\.(\d{4})(\d\d)(\d\d)-(\d\d)(\d\d)\d\d\.log", path.name)
        when = f"{match[2]}-{match[3]} {match[4]}:{match[5]}" if match else path.name
        files.append((path, tr(f"Proton 日志（{when}）", f"Proton log ({when})")))
    return files


def human_size(size):
    for unit in ("B", "KiB", "MiB"):
        if size < 1024:
            return f"{size:.1f} {unit}" if unit == "MiB" else f"{size:.0f} {unit}"
        size /= 1024
    return f"{size:.1f} GiB"


def read_log_tail(path, limit=LOG_TAIL):
    """The end of a log as text, and whether earlier lines were left out."""
    with open(path, "rb") as f:
        size = f.seek(0, os.SEEK_END)
        f.seek(max(0, size - limit))
        data = f.read()
    truncated = size > limit
    if truncated:
        data = data[data.find(b"\n") + 1:]  # drop the partial first line
    return data.decode("utf-8", errors="replace"), truncated


def clear_logs():
    if is_running():
        raise LauncherError(tr("WeGame 正在运行，不能清空日志", "WeGame is running; cannot clear the logs"))
    for path in LOGS.glob("*.log"):
        path.unlink(missing_ok=True)


def open_path(path):
    subprocess.Popen(["xdg-open", str(path)], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


MAX_RELAUNCHES = 3


def update_payload_pending():
    """Downloaded update files still waiting next to the client."""
    return (INSTALL_DIR / "wegame_update").is_dir() or any(INSTALL_DIR.glob("multi_group/*/*/update_files"))


def wait_prefix_idle(timeout=60):
    deadline = time.monotonic() + timeout
    while prefix_pids():
        if time.monotonic() > deadline:
            return False
        time.sleep(1)
    return True


def run_supervised(args=(), notify=lambda message: None):
    """Launch WeGame and wait for it. WeGame quits after downloading an
    update and expects its updater to swap the files and start it again;
    under Proton that restart never happens, so do it here."""
    if is_running():  # e.g. a wegame:// link while WeGame is open
        return launch(args).wait()
    status = 0
    for attempt in range(MAX_RELAUNCHES + 1):
        version = client_version()
        NO_RELAUNCH.unlink(missing_ok=True)
        status = launch(args).wait()
        # The main process can exit while helpers finish; still busy after
        # a minute means WeGame restarted itself and needs no help.
        if not wait_prefix_idle() or NO_RELAUNCH.exists():
            break
        # A plain exit also leaves a status-only update.tmp behind, so only
        # a waiting payload or a changed version counts as an update.
        if not (update_payload_pending() or client_version() != version):
            break
        if attempt == MAX_RELAUNCHES:
            notify(tr("WeGame 连续多次因更新退出，已停止自动重启", "WeGame kept exiting for updates; stopped restarting it"))
            break
        notify(tr("WeGame 已下载更新，正在重新启动…", "WeGame downloaded an update; restarting it…"))
        args = ()  # a wegame:// link was for the first start only
    return status


def open_folder():
    ROOT.mkdir(parents=True, exist_ok=True)
    open_path(ROOT)


