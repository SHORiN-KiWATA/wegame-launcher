        # -------------------------------------------------------- log view
        def build_log_view(self):
            page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, width_request=720, height_request=480,
                           hexpand=True, vexpand=True,
                           margin_top=14, margin_bottom=14, margin_start=20, margin_end=20)
            # Leave room on the right for the window's close button.
            header = Gtk.Box(spacing=6, margin_end=34)
            header.append(icon_button("go-previous-symbolic", tr("返回", "Back"), self.show_logs))
            self.log_title = Gtk.Label(xalign=0, hexpand=True, ellipsize=Pango.EllipsizeMode.END, css_classes=["heading"])
            header.append(self.log_title)
            header.append(icon_button("edit-copy-symbolic", tr("复制显示的内容", "Copy what is shown"), self.copy_log))
            header.append(icon_button("document-open-symbolic", tr("用其他程序打开", "Open in another app"),
                                      lambda: open_path(self.log_path)))
            page.append(header)

            self.log_filter = Gtk.SearchEntry(placeholder_text=tr("筛选：只显示包含这段文字的行",
                                                                  "Filter: only lines containing this text"))
            self.log_filter.connect("search-changed", lambda *_: self.render_log(keep_bottom=True))
            page.append(self.log_filter)

            self.log_buffer = Gtk.TextBuffer()
