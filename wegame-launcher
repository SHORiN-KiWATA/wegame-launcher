class InstallLock:
    def __enter__(self):
        ROOT.mkdir(parents=True, exist_ok=True)
        self.file = open(ROOT / ".lock", "w")
        try:
            fcntl.flock(self.file, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise LauncherError(tr("另一个安装任务正在进行", "Another install is already running"))
        return self

    def __exit__(self, *exc):
        self.file.close()


def _install(progress, force_client=False):
    """Runner, prefix, client and registry; finished steps are skipped."""
    ensure_runner(progress)
    if not (PFX / "drive_c").is_dir():
        progress(tr("初始化前缀（首次需要几分钟）…", "Creating the prefix (takes a few minutes)…"), None)
        proton_run("run", "wineboot", "-u")
        stop_prefix()
    if force_client or not CLIENT.is_file():
        _, package = fetch_wegame(progress)
        extract_client(package, progress)
        import_registry(progress)
        # WeGame cannot be running here: the client was missing, or
        # reinstall refused to start while it ran.
        stop_prefix()


def install(progress=_quiet):
    with InstallLock():
        _install(progress)
        progress(tr("安装完成", "Installed"), 1.0)


def reinstall(progress=_quiet):
    """Unpack the client again over the existing one; login data stays."""
    if is_running():
        raise LauncherError(tr("WeGame 正在运行，请先强制退出", "WeGame is running; force quit it first"))
    with InstallLock():
        _install(progress, force_client=True)
        progress(tr("重新安装完成", "Reinstalled"), 1.0)


def rebuild(progress=_quiet):
    """Throw the whole prefix away (including WeGame login data) and start over."""
    with InstallLock():
        kill_all()
        progress(tr("删除旧前缀…", "Removing the old prefix…"), None)
        shutil.rmtree(PREFIX, ignore_errors=True)
        _install(progress)
        progress(tr("重建完成", "Rebuilt"), 1.0)


GAMESCOPE_DEFAULTS = {"enabled": False, "fullscreen": False, "resolution": "", "fps": "", "fsr": False, "args": ""}


def gamescope_settings():
    return {**GAMESCOPE_DEFAULTS, **load_config().get("gamescope", {})}


def set_gamescope(**changes):
    save_config(gamescope={**gamescope_settings(), **changes})


def gamescope_command():
    """gamescope [options] -- prefix, or [] when disabled. Running WeGame
    nested in its own compositor sidesteps the compositor-specific window
    problems of its layered login and main windows."""
    settings = gamescope_settings()
    if not settings["enabled"]:
        return []
    binary = shutil.which("gamescope")
    if not binary:
        raise LauncherError(tr("已开启 Gamescope，但没有安装 gamescope", "Gamescope is enabled but not installed"))
    command = [binary]
    if settings["fullscreen"]:
        command.append("-f")
    if settings["resolution"]:
        match = re.fullmatch(r"(\d+)x(\d+)", settings["resolution"])
        if not match:
            raise LauncherError(tr(f"分辨率格式应为 宽x高：{settings['resolution']}", f"Resolution must be WxH: {settings['resolution']}"))
        width, height = match.groups()
        # Same size inside and out, so WeGame renders 1:1 in the window.
        command += ["-w", width, "-h", height, "-W", width, "-H", height]
    if settings["fps"]:
        command += ["-r", str(settings["fps"])]
    if settings["fsr"]:
        command += ["-F", "fsr"]
    try:
        command += shlex.split(settings["args"])
    except ValueError as exc:
        raise LauncherError(tr(f"Gamescope 参数有误：{exc}", f"Invalid Gamescope arguments: {exc}"))
    return command + ["--"]


def launch(args=()):
    """Start WeGame detached and return its Popen."""
    if not is_installed():
        raise LauncherError(tr("WeGame 还没有安装", "WeGame is not installed"))
    # A second launch while WeGame runs (e.g. a wegame:// link) must not
    # touch files the running client has open.
    running = is_running()
    if not running:
        recover_updates()
    LOGS.mkdir(parents=True, exist_ok=True)
    log = open(LOGS / "wegame.log", "a")
    log.write(f"\n--- {datetime.now():%F %T} launch\n")
    log.flush()
    command = [*gamescope_command(), str(require_runner()), "waitforexitandrun", str(CLIENT), *args]
    env = proton_env()
    proton_log_settings(env, fresh_session=not running)
    if load_config().get("mangohud"):
        if not shutil.which("mangohud"):
            raise LauncherError(tr("已开启 MangoHud，但没有安装 mangohud", "MangoHud is enabled but not installed"))
        env["MANGOHUD"] = "1"  # DXVK's Vulkan picks up the MangoHud layer
    with log:
        return subprocess.Popen(command, env=env, cwd=INSTALL_DIR, stdout=log, stderr=log,
                                stdin=subprocess.DEVNULL, start_new_session=True)


