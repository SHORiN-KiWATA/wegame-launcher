# ---------------------------------------------------------------- downloads


def retrying(action):
    """Run action(), retrying OSErrors with exponential backoff."""
    for attempt in range(RETRIES):
        try:
            return action()
        except OSError:
            if attempt == RETRIES - 1:
                raise
            time.sleep(2 ** (attempt + 1))


def http_get(url, body=None):
    data = json.dumps(body).encode() if body is not None else None
    headers = {"User-Agent": USER_AGENT}
    if data is not None:
        headers["Content-Type"] = "application/json;charset=UTF-8"
        headers["Referer"] = "https://www.wegame.com.cn/"

    def fetch():
        request = urllib.request.Request(url, data=data, headers=headers)
        with urllib.request.urlopen(request, timeout=30) as response:
            return response.read()

    return retrying(fetch)


def http_json(url, body=None):
    return json.loads(http_get(url, body))


def download(url, dest: Path, label, progress=_quiet):
    """Download url to dest, resuming partial downloads across retries and runs."""
    dest.parent.mkdir(parents=True, exist_ok=True)
    part = dest.with_name(dest.name + ".part")

    def attempt():
        offset = part.stat().st_size if part.exists() else 0
        headers = {"User-Agent": USER_AGENT}
        if offset:
            headers["Range"] = f"bytes={offset}-"
        request = urllib.request.Request(url, headers=headers)
        # The timeout applies to each read, so it doubles as stall detection.
        with urllib.request.urlopen(request, timeout=STALL_SECONDS) as response:
            if offset and response.status != 206:
                offset = 0
            total = offset + int(response.headers.get("Content-Length") or 0)
            done = offset
            with open(part, "ab" if offset else "wb") as out:
                while chunk := response.read(1 << 20):
                    out.write(chunk)
                    done += len(chunk)
                    if total:
                        progress(f"{label}  {done / 2**20:.0f} / {total / 2**20:.0f} MiB", done / total)

    try:
        retrying(attempt)
    except OSError as exc:
        raise LauncherError(tr(f"下载失败（再次安装会续传）：{url}\n{exc}", f"Download failed (installing again resumes): {url}\n{exc}"))
    part.replace(dest)
    return dest


def file_digest(path: Path, algorithm, label, progress=_quiet):
    digest = hashlib.new(algorithm)
    size = path.stat().st_size or 1
    done = 0
    with open(path, "rb") as f:
        while chunk := f.read(1 << 22):
            digest.update(chunk)
            done += len(chunk)
            progress(label, done / size)
    return digest.hexdigest()


# ------------------------------------------------------------------ runner


def load_config():
    try:
        return json.loads(CONFIG.read_text())
    except (OSError, ValueError):
        return {}


def save_config(**changes):
    config = {**load_config(), **changes}
    ROOT.mkdir(parents=True, exist_ok=True)
    CONFIG.write_text(json.dumps(config, indent=2) + "\n")


def runner_label(proton: Path):
    # Proton's version file reads "<timestamp> <name>".
    try:
        return (proton.parent / "version").read_text().split()[-1]
    except (OSError, IndexError):
        return proton.parent.name


def steam_roots():
    roots = [HOME / ".local/share/Steam", HOME / ".steam/steam", HOME / ".steam/root",
             HOME / ".var/app/com.valvesoftware.Steam/data/Steam"]
    libraries = []
    for root in roots:
        libraries.append(root)
        try:
            vdf = (root / "steamapps/libraryfolders.vdf").read_text(errors="replace")
        except OSError:
            continue
        libraries += [Path(m) for m in re.findall(r'"path"\s+"([^"]+)"', vdf)]
    return libraries


def find_runners():
    """Every Proton on the machine as {label: path}, ours first."""
    patterns = [RUNNER_DIR / "*/proton",
                Path("/usr/share/steam/compatibilitytools.d/*/proton"),
                HOME / ".local/share/proton/runners/*/proton",  # shorin-proton-wrapper
                HOME / ".local/share/lutris/runners/proton/*/proton",
                HOME / ".local/share/lutris/runners/wine/*/proton",
                HOME / ".config/heroic/tools/proton/*/proton"]
    for root in steam_roots():
        patterns += [root / "compatibilitytools.d/*/proton", root / "steamapps/common/Proton*/proton"]
    found, seen = {}, set()
    for pattern in patterns:
        for proton in sorted(Path(pattern.anchor).glob(str(pattern.relative_to(pattern.anchor)))):
            real = proton.resolve()
            if proton.is_file() and real not in seen:
                seen.add(real)
                label = runner_label(proton)
                found.setdefault(label if label not in found else f"{label} ({proton.parent})", proton)
    return found


def is_dwproton(label):
    return "dwproton" in label.lower().replace("-", "")


def auto_runner():
    """The newest DW-Proton found anywhere, or None."""
    dw = {label: path for label, path in find_runners().items() if is_dwproton(label)}
    if not dw:
        return None
    return dw[max(dw, key=version_key)]


def current_runner():
    """The proton to use: WEGAME_LAUNCHER_PROTON, the user's pick, or the
    newest DW-Proton found. None when nothing usable is installed."""
    override = os.environ.get("WEGAME_LAUNCHER_PROTON")
    if override:
        return Path(override) if Path(override).is_file() else None
    picked = load_config().get("runner")
    if picked and Path(picked).is_file():
        return Path(picked)
    return auto_runner()


def require_runner():
    proton = current_runner()
    if proton is None:
        raise LauncherError(tr("没有可用的 Proton，请先安装", "No usable Proton; install first"))
    return proton


def runner_name():
    proton = current_runner()
    return runner_label(proton) if proton else "-"


def download_dwproton(progress=_quiet):
    """Download the latest DW-Proton into ~/.wegame-launcher/runner."""
    progress(tr("正在查询 DW-Proton 最新版本…", "Looking up the latest DW-Proton…"), None)
    try:
        release = http_json(DW_RELEASE_API)
    except (OSError, ValueError) as exc:
        raise LauncherError(tr(f"无法获取 DW-Proton 版本信息：{exc}", f"Cannot fetch DW-Proton release info: {exc}"))
    tag = release["tag_name"]
    assets = {a["name"]: a["browser_download_url"] for a in release.get("assets", [])}
    archive = next((n for n in assets if n.endswith("x86_64.tar.xz")), None)
    checksum = next((n for n in assets if n.endswith("x86_64.sha512sum")), None)
    if not archive or not checksum:
        raise LauncherError(tr(f"{tag} 缺少 x86_64 压缩包或校验文件", f"{tag} has no x86_64 archive or checksum"))
    if (RUNNER_DIR / tag / "proton").is_file():
        return RUNNER_DIR / tag / "proton"

    tarball = download(assets[archive], DOWNLOADS / archive, tr(f"下载 {tag}", f"Downloading {tag}"), progress)
    try:
        expected = http_get(assets[checksum]).decode().split()[0]
    except OSError as exc:
        raise LauncherError(tr(f"无法获取 DW-Proton 校验值：{exc}", f"Cannot fetch the DW-Proton checksum: {exc}"))
    if file_digest(tarball, "sha512", tr("校验 DW-Proton…", "Verifying DW-Proton…"), progress) != expected:
        tarball.unlink()
        raise LauncherError(tr("DW-Proton 校验失败，已删除，请重试", "DW-Proton checksum mismatch; removed, please retry"))

    staging = RUNNER_DIR / f".{tag}.tmp"
    shutil.rmtree(staging, ignore_errors=True)
    staging.mkdir(parents=True)
    size = tarball.stat().st_size
    with open(tarball, "rb") as raw, tarfile.open(fileobj=raw, mode="r|xz") as tar:
        for member in tar:
            tar.extract(member, staging, filter="tar")
            progress(tr(f"解压 {tag}…", f"Extracting {tag}…"), raw.tell() / size)
    proton = next(staging.glob("*/proton"), None)
    if proton is None:
        raise LauncherError(tr("DW-Proton 压缩包里没有 proton", "No proton script in the DW-Proton archive"))
    shutil.rmtree(RUNNER_DIR / tag, ignore_errors=True)
    proton.parent.rename(RUNNER_DIR / tag)
    shutil.rmtree(staging)
    tarball.unlink()
    # Keep only the newest download; Protons from elsewhere are not ours to touch.
    for old in RUNNER_DIR.iterdir():
        if old.is_dir() and old.name != tag and not old.name.startswith("."):
            shutil.rmtree(old, ignore_errors=True)
    return RUNNER_DIR / tag / "proton"


def ensure_runner(progress=_quiet):
    return current_runner() or download_dwproton(progress)


def choose_runner(choice):
    """Remember a Proton by label or path; "auto" goes back to the newest DW-Proton."""
    if choice == "auto":
        save_config(runner=None)
        return
    runners = find_runners()
    proton = runners.get(choice) or Path(choice).expanduser()
    if proton.is_dir():
        proton = proton / "proton"
    if not proton.is_file():
        raise LauncherError(tr(f"找不到这个 Proton：{choice}", f"No such Proton: {choice}"))
    save_config(runner=str(proton.resolve()))


def sevenzip(progress=_quiet):
    """A 7z binary: the system's, or the official static build fetched once."""
    for name in ("7z", "7zz", "7za"):
        if path := shutil.which(name):
            return path
    binary = TOOLS_DIR / "7zzs"
    if binary.is_file():
        return str(binary)
    archive = download(SEVENZIP_URL, DOWNLOADS / "7z-linux-x64.tar.xz", tr("下载 7-Zip", "Downloading 7-Zip"), progress)
    if file_digest(archive, "sha256", tr("校验 7-Zip…", "Verifying 7-Zip…")) != SEVENZIP_SHA256:
        archive.unlink()
        raise LauncherError(tr("7-Zip 校验失败，已删除，请重试", "7-Zip checksum mismatch; removed, please retry"))
    TOOLS_DIR.mkdir(parents=True, exist_ok=True)
    with tarfile.open(archive) as tar:
        member = tar.getmember("7zzs")
        member.name = binary.name
        tar.extract(member, TOOLS_DIR, filter="tar")
    archive.unlink()
    binary.chmod(0o755)
    return str(binary)


def proton_env():
    # Proton refuses to start unless both directories already exist.
    PREFIX.mkdir(parents=True, exist_ok=True)
    STEAM_DIR.mkdir(parents=True, exist_ok=True)
    env = dict(os.environ)
    env.update(
        STEAM_COMPAT_DATA_PATH=str(PREFIX),
        STEAM_COMPAT_CLIENT_INSTALL_PATH=str(STEAM_DIR),
        SteamAppId="0",
        SteamGameId="0",
        # Outside Steam, Proton's lsteamclient asserts on the missing native
        # steamclient and wineboot hangs; the umu variables turn it off.
        UMU_ID="wegame-launcher",
        UMU_USE_STEAM="0",
    )
    # WeGame is 32-bit. In Wine's new WoW64 mode it runs through the 64-bit
    # host libraries only, so no lib32 packages are needed; the old mode
    # crashes outright when e.g. 32-bit libgcc_s is missing.
    if load_config().get("wow64", True):
        env.setdefault("PROTON_USE_WOW64", "1")
    return env


def proton_run(*args, log_name="setup.log"):
    proton = require_runner()
    LOGS.mkdir(parents=True, exist_ok=True)
    with open(LOGS / log_name, "a") as log:
        log.write(f"\n--- {datetime.now():%F %T} proton {' '.join(args)}\n")
        log.flush()
        status = subprocess.call([str(proton), *args], env=proton_env(), stdout=log, stderr=log)
    if status != 0:
        raise LauncherError(tr(f"proton {args[0]} 失败（{status}），见 {LOGS / log_name}",
                               f"proton {args[0]} failed ({status}), see {LOGS / log_name}"))


# ------------------------------------------------------------------ wegame


def wegame_package():
    """(version, url) of the newest offline package Tencent lists."""
    try:
        data = http_json(WEGAME_CONFIG_API, WEGAME_CONFIG_BODY)
        found = {m.group(1): m.group(0)
                 for item in data.get("items", [])
                 for m in WEGAME_FULL_RE.finditer(str(item.get("value", "")))}
    except (OSError, ValueError):
        found = {}
    if not found:
        return WEGAME_FALLBACK
    version = max(found, key=version_key)
    return version, found[version]


def version_key(version):
    return tuple(int(p) for p in re.findall(r"\d+", version))


def fetch_wegame(progress=_quiet):
    progress(tr("正在查询 WeGame 离线安装包…", "Looking up the WeGame offline package…"), None)
    version, url = wegame_package()
    dest = DOWNLOADS / f"WeGame-{version}.zip"
    if not dest.exists():
        download(url, dest, tr(f"下载 WeGame {version}", f"Downloading WeGame {version}"), progress)
    label = tr("校验 WeGame 安装包…", "Verifying the WeGame package…")
    expected = WEGAME_SHA256.get(version)
    if expected:
        ok = file_digest(dest, "sha256", label, progress) == expected
    else:
        progress(label, None)
        try:
            with zipfile.ZipFile(dest) as z:
                ok = z.testzip() is None
        except zipfile.BadZipFile:
            ok = False
    if not ok:
        dest.unlink()
        raise LauncherError(tr("WeGame 安装包校验失败，已删除，请重试", "WeGame package check failed; removed, please retry"))
    return version, dest


def run_7z(archive: Path, out: Path, label, progress=_quiet):
    out.mkdir(parents=True, exist_ok=True)
    proc = subprocess.Popen(
        [sevenzip(progress), "x", "-y", "-aoa", "-bso0", "-bsp1", f"-o{out}", str(archive)],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE,
    )
    buffer = b""
    while chunk := proc.stdout.read(256):
        buffer = (buffer + chunk)[-64:]
        if found := re.findall(rb"(\d{1,3})%", buffer):
            progress(label, int(found[-1]) / 100)
    stderr = proc.stderr.read().decode(errors="replace")
    # Both NSIS layers make 7z report "Headers Error" (exit 2) although every
    # file is extracted; callers check for the files they need instead.
    if proc.wait() not in (0, 2):
        raise LauncherError(tr(f"解压失败：{archive.name}\n{stderr}", f"Extraction failed: {archive.name}\n{stderr}"))


def extract_client(package: Path, progress=_quiet):
    """Unpack the offline installer straight into the prefix, like the
    installer itself would: overwrite files, never delete user data."""
    stage = CACHE / "stage"
    shutil.rmtree(stage, ignore_errors=True)
    stage.mkdir(parents=True)
    try:
        progress(tr("解压安装包…", "Unpacking the package…"), None)
        with zipfile.ZipFile(package) as z:
            setup = next(n for n in z.namelist() if n.lower().endswith(".exe"))
            z.extract(setup, stage)
        run_7z(stage / setup, stage / "outer", tr("解压安装程序…", "Unpacking the installer…"), progress)
        inner = stage / "outer" / "WeGameSetup.exe"
        if not inner.is_file():
            raise LauncherError(tr("安装包结构不对：缺少 WeGameSetup.exe", "Unexpected package layout: no WeGameSetup.exe"))
        run_7z(inner, INSTALL_DIR, tr("安装 WeGame 文件…", "Installing WeGame files…"), progress)
    finally:
        shutil.rmtree(stage, ignore_errors=True)
    if not CLIENT.is_file():
        raise LauncherError(tr("解压后没有找到 wegame.exe", "wegame.exe missing after extraction"))
    # Installer plugins, kernel drivers (useless under Wine) and the stale
    # *_temp_ copies the installer deletes itself.
    for junk in ("$PLUGINSDIR", "$SYSDIR"):
        shutil.rmtree(INSTALL_DIR / junk, ignore_errors=True)
    for temp in INSTALL_DIR.rglob("*_temp_"):
        temp.unlink()


def import_registry(progress=_quiet):
    progress(tr("写入注册表…", "Writing registry entries…"), None)
    reg = CACHE / "wegame.reg"
    reg.write_text(REGISTRY.replace("\n", "\r\n"), encoding="ascii")
    proton_run("run", "regedit", "/S", "Z:" + str(reg).replace("/", "\\"))


def client_version():
    try:
        text = (INSTALL_DIR / "mmog_data.xml").read_text(encoding="gb18030")
    except OSError:
        return None
    match = re.search(r"<Version>([0-9.]+)</Version>", text)
    return match.group(1) if match else None


def is_installed():
    return CLIENT.is_file() and current_runner() is not None


# ------------------------------------------------------- update recovery


def ini_value(path: Path, key):
    for line in path.read_text(errors="replace").splitlines():
        if line.startswith(key + "="):
            return line[len(key) + 1:].strip()
    return None


def finish_failed_update(status: Path, payload: Path):
    """WeGame downloads updates next to the client and records the result in
    update.tmp. Under Wine the final move can fail and leave the complete
    payload with OverwriteStatus set and TickMoveFile=-1; finish that move,
    backing up every replaced file."""
    if not (status.is_file() and payload.is_dir()):
        return
    overwrite = ini_value(status, "OverwriteStatus")
    if overwrite in (None, "", "0") or ini_value(status, "TickMoveFile") != "-1":
        return  # Not the known failure: WeGame's own updater handles it.
    files = []
    for path in payload.rglob("*"):
        if path.is_symlink() or not (path.is_file() or path.is_dir()):
            raise LauncherError(tr(f"更新包里有链接或特殊文件，已拒绝：{path}", f"Refusing update payload with links or special files: {path}"))
        if path.is_file() and path.relative_to(payload) != Path("repo_update.ini"):
            files.append(path.relative_to(payload))

    name = str(payload.relative_to(INSTALL_DIR)).replace("/", "_")
    backup = BACKUP_DIR / f"{datetime.now():%Y%m%d-%H%M%S}-{name}"
    for rel in files:
        dest = INSTALL_DIR / rel
        if dest.is_file():
            (backup / "replaced" / rel).parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(dest, backup / "replaced" / rel)
        dest.parent.mkdir(parents=True, exist_ok=True)
        temp = dest.with_name(dest.name + ".wegame-launcher-new")
        shutil.copy2(payload / rel, temp)
        temp.replace(dest)
    backup.mkdir(parents=True, exist_ok=True)
    payload.rename(backup / "payload")
    status.rename(backup / "update.tmp")


def recover_updates():
    if not INSTALL_DIR.is_dir():
        return
    finish_failed_update(INSTALL_DIR / "update.tmp", INSTALL_DIR / "wegame_update")
    for slot in sorted(INSTALL_DIR.glob("multi_group/*/*")):
        finish_failed_update(slot / "update.tmp", slot / "update_files")


# --------------------------------------------------------------- processes


def process_environ(entry):
    """The environment of /proc/<pid>. When the main thread has exited but
    other threads live on (a zombie leader, common after wineserver dies),
    the process environ is unreadable; read it through a live thread."""
    for path in [entry / "environ", *(entry / "task").glob("*/environ")]:
        try:
            environ = path.read_bytes()
        except OSError:
            continue
        if environ:
            return environ.split(b"\0")
    return []


def prefix_pids():
    """PIDs of every process (wineserver included) running in our prefix."""
    markers = {f"STEAM_COMPAT_DATA_PATH={PREFIX}".encode(), f"WINEPREFIX={PFX}".encode()}
    pids = []
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit() or int(entry.name) == os.getpid():
            continue
        if markers.intersection(process_environ(entry)):
            pids.append(int(entry.name))
    return pids


def is_running():
    return bool(prefix_pids())


def stop_prefix():
    """Shut the prefix down after setup steps: Wine's helper services would
    otherwise linger and make WeGame look like it is running."""
    proton = current_runner()
    if proton is None:
        return
    wineserver = proton.parent / "files" / "bin" / "wineserver"
    env = {**proton_env(), "WINEPREFIX": str(PFX)}
    try:
        subprocess.run([str(wineserver), "-k"], env=env, timeout=30,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run([str(wineserver), "-w"], env=env, timeout=30,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired):
        pass
    kill_all()


NO_RELAUNCH = ROOT / ".no-relaunch"


def kill_all():
    # Tells a supervising launcher not to restart what the user just killed.
    ROOT.mkdir(parents=True, exist_ok=True)
    NO_RELAUNCH.touch()
    pids = prefix_pids()
    for pid in pids:
        try:
            os.kill(pid, signal.SIGKILL)
        except OSError:
            pass
    return len(pids)


