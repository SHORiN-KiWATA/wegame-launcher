        def show_log(self, path, title):
            if self.stack.get_visible_child_name() != "log-view":
                # The viewer is wider than the other pages; shrink back afterwards.
                self.size_before_log = (self.get_width(), self.get_height())
            self.log_path = path
            self.log_stamp = ()  # nothing loaded yet
            self.log_raw = ""
            self.log_title.set_text(title)
            self.log_filter.set_text("")
            self.stack.set_visible_child_name("log-view")
            if self.log_timer:
                GLib.source_remove(self.log_timer)
            self.poll_log()
            self.log_timer = GLib.timeout_add_seconds(2, self.poll_log)

        def leave_log_view(self):
            if self.log_timer:
                GLib.source_remove(self.log_timer)
                self.log_timer = None
            if self.size_before_log and self.stack.get_visible_child_name() == "log-view":
                # Only after the page transition, while the stack still interpolates its size.
                size, self.size_before_log = self.size_before_log, None
                GLib.timeout_add(self.stack.get_transition_duration() + 50,
                                 lambda: self.set_default_size(*size) or False)

        def poll_log(self):
            """Reload the log when it changed, following its end like tail -f."""
            try:
                stat = self.log_path.stat()
                stamp = (stat.st_size, stat.st_mtime_ns)
            except OSError:
                stamp = None
            if stamp == self.log_stamp:
                return True
            first = self.log_stamp == ()
            follow = first or self.log_at_bottom()
            self.log_stamp = stamp
            note = [str(self.log_path).replace(str(HOME), "~", 1)]
            if stamp is None:
                self.log_raw = ""
                note.append(tr("文件不存在", "file is gone"))
            else:
                try:
                    self.log_raw, truncated = read_log_tail(self.log_path)
                except OSError as exc:
                    self.log_raw, truncated = "", False
                    note.append(str(exc))
                note.append(human_size(stamp[0]))
                if truncated:
                    note.append(tr(f"只显示最后 {LOG_TAIL // 1024} KiB", f"showing the last {LOG_TAIL // 1024} KiB"))
            self.log_note.set_text(" · ".join(note))
            self.render_log(keep_bottom=follow)
            return True

        def log_at_bottom(self):
            adjustment = self.log_scroller.get_vadjustment()
            return adjustment.get_value() >= adjustment.get_upper() - adjustment.get_page_size() - 24

        def render_log(self, keep_bottom):
            text = self.log_raw
            needle = self.log_filter.get_text().lower()
            if needle:
                text = "\n".join(line for line in text.splitlines() if needle in line.lower())
            if not text:
                text = tr("（没有匹配的行）", "(no matching lines)") if needle else tr("（空）", "(empty)")
            self.log_follow = keep_bottom
            self.log_buffer.set_text(text)
            self.on_log_layout(self.log_scroller.get_vadjustment())

        def on_log_layout(self, adjustment):
            # Long text is laid out in chunks after set_text(); keep to the end meanwhile.
            if self.log_follow:
                adjustment.set_value(adjustment.get_upper() - adjustment.get_page_size())

        def copy_log(self):
            start, end = self.log_buffer.get_bounds()
            text = self.log_buffer.get_text(start, end, False)
            self.get_clipboard().set_content(Gdk.ContentProvider.new_for_value(text))

        # ----------------------------------------------------------- state
        def refresh(self):
            if self.busy:
                return True
            installed = is_installed()
            running = installed and is_running()
            self.install_button.set_visible(not installed)
            self.run_box.set_visible(installed)
            self.settings_button.set_sensitive(True)
            self.launch_button.set_sensitive(not running)
            self.kill_button.set_sensitive(running)
            self.progress.set_visible(False)
            if installed and not self.logo_image.get_visible():
                texture = wegame_icon()
                if texture:
                    self.logo_image.set_from_paintable(texture)
                    self.logo_image.set_visible(True)
            if self.error:
                self.set_status(self.error, error=True)
            elif not installed:
                if current_runner():
                    self.set_status(tr(f"将使用 {runner_name()}，并下载 WeGame 官方离线安装包",
                                       f"Uses {runner_name()} and downloads the official WeGame offline package"))
                else:
                    self.set_status(tr("将下载 DW-Proton 和 WeGame 官方离线安装包",
                                       "Downloads DW-Proton and the official WeGame offline package"))
            elif running:
                self.set_status(tr("WeGame 运行中", "WeGame is running"))
            else:
                extras = [name for name, on in (("Gamescope", gamescope_settings()["enabled"]),
                                                ("MangoHud", load_config().get("mangohud"))) if on]
                self.set_status(" · ".join([f"WeGame {client_version() or '?'}", runner_name(), *extras]))
            return True

        def set_status(self, text, error=False):
            self.status.set_text(text)
            (self.status.add_css_class if error else self.status.remove_css_class)("status-error")

        def set_progress(self, message, fraction):
            self.set_status(message)
            if fraction is None:
                self.progress.pulse()
            else:
                self.progress.set_fraction(fraction)
            return False

        def start_task(self, task):
            self.show_main()
            self.busy = True
            self.error = None
            self.install_button.set_visible(False)
            self.run_box.set_visible(False)
            self.settings_button.set_sensitive(False)
            self.progress.set_visible(True)
            self.progress.set_fraction(0)
            last = [0.0]

            def progress(message, fraction=None):
                # Tar and 7z report per file; don't flood the main loop.
                now = time.monotonic()
                if fraction is None or fraction >= 1 or now - last[0] > 0.1:
                    last[0] = now
                    GLib.idle_add(self.set_progress, message, fraction)

            def worker():
                try:
                    task(progress)
                    error = None
                except LauncherError as exc:
                    error = str(exc)
                except Exception as exc:  # Show anything unexpected instead of hanging.
                    error = f"{type(exc).__name__}: {exc}"
                GLib.idle_add(self.task_done, error)

            threading.Thread(target=worker, daemon=True).start()

        def task_done(self, error):
            self.busy = False
            self.error = error
            if error:
                self.install_button.set_label(tr("重试", "Retry"))
            self.refresh()
            return False

        # --------------------------------------------------------- actions
        def on_launch(self, *_):
            self.error = None
            self.launch_button.set_sensitive(False)
            self.set_status(tr("正在启动 WeGame…", "Starting WeGame…"))

            def supervise():
                try:
                    run_supervised(notify=lambda message: GLib.idle_add(self.set_status, message))
                except LauncherError as exc:
                    GLib.idle_add(self.launch_failed, str(exc))

            threading.Thread(target=supervise, daemon=True).start()

        def launch_failed(self, error):
            self.error = error
            self.refresh()
            return False

        def on_kill(self, *_):
            self.error = None
            count = kill_all()
            self.set_status(tr(f"已结束 {count} 个进程", f"Killed {count} processes"))

        def confirm(self, message, callback):
            dialog = Gtk.AlertDialog(message=message, buttons=[tr("取消", "Cancel"), tr("继续", "Continue")],
                                     cancel_button=0, default_button=0)

            def done(dialog, result):
                try:
                    if dialog.choose_finish(result) == 1:
                        callback()
                except GLib.Error:
                    pass

            dialog.choose(self, None, done)

        def on_reinstall(self, *_):
            self.confirm(tr("用离线安装包覆盖安装 WeGame？登录数据和设置会保留。",
                            "Unpack WeGame again over the current install? Login data and settings are kept."),
                         lambda: self.start_task(reinstall))

        def on_rebuild(self, *_):
            self.confirm(tr("删除整个前缀并重新安装？WeGame 的登录数据会丢失。",
                            "Delete the whole prefix and install again? WeGame login data will be lost."),
                         lambda: self.start_task(rebuild))

        def on_download_runner(self, *_):
            def task(progress):
                download_dwproton(progress)
                save_config(runner=None)
            self.start_task(task)

    def activate(app):
        if not app.get_active_window():
            install_style()
            Window(app)
        app.get_active_window().present()

    app = Gtk.Application(application_id=APP_ID)
    app.connect("activate", activate)
    return app.run([sys.argv[0]])


# --------------------------------------------------------------------- CLI


def cli_progress():
    last = [None, False]  # previous message, progress line still open

    def progress(message, fraction=None):
        if fraction is None:
            if message != last[0]:
                if last[1]:
                    print(file=sys.stderr)  # end the previous progress line
                print(message, file=sys.stderr)
            last[1] = False
        else:
            print(f"\r\033[K{message}  {fraction * 100:5.1f}%", end="", file=sys.stderr)
            last[1] = fraction < 1
            if fraction >= 1:
                print(file=sys.stderr)
        last[0] = message

    return progress


def main():
    parser = argparse.ArgumentParser(
        prog="wegame-launcher",
        description=tr("在独立的 DW-Proton 前缀里安装和运行 WeGame。不带参数时打开图形界面。",
                       "Install and run WeGame in its own DW-Proton prefix. Opens the GUI without arguments."),
    )
    sub = parser.add_subparsers(dest="command")
    sub.add_parser("install", help=tr("下载 WeGame 并配置前缀", "download WeGame and set up the prefix"))
    run = sub.add_parser("run", help=tr("启动 WeGame（可带 wegame:// 链接）", "launch WeGame (optionally with a wegame:// link)"))
    run.add_argument("args", nargs=argparse.REMAINDER)
    sub.add_parser("kill", help=tr("强制结束前缀里的所有进程", "force kill every process in the prefix"))
    sub.add_parser("reinstall", help=tr("覆盖安装 WeGame，保留登录数据", "unpack WeGame again, keeping login data"))
    sub.add_parser("rebuild", help=tr("删除整个前缀后重新安装", "delete the whole prefix and install again"))
    sub.add_parser("status", help=tr("显示安装状态", "show install state"))
    gs = sub.add_parser("gamescope", help=tr("设置 Gamescope", "configure Gamescope"),
                        description=tr("不带参数显示当前设置。WeGame 窗口显示异常时可以开启。",
                                       "Without arguments, show the settings. Turn it on when WeGame's windows misbehave."))
    gs.add_argument("state", nargs="?", choices=["on", "off"])
    gs.add_argument("--fullscreen", choices=["on", "off"], help=tr("全屏（默认窗口模式）", "fullscreen (windowed by default)"))
    gs.add_argument("--res", metavar=tr("宽x高", "WxH"), help=tr("窗口和渲染分辨率，空字符串表示默认", "window and render size; empty for default"))
    gs.add_argument("--fps", metavar="N", help=tr("限制帧率，空字符串表示不限", "frame limit; empty for none"))
    gs.add_argument("--fsr", choices=["on", "off"], help=tr("FSR 超分辨率", "FSR upscaling"))
    gs.add_argument("--args", metavar=tr("参数", "ARGS"), help=tr("追加的 gamescope 参数，写成 --args='--xxx'", "extra gamescope arguments, written as --args='--xxx'"))
    mangohud = sub.add_parser("mangohud", help=tr("MangoHud 性能叠加层", "MangoHud performance overlay"))
    mangohud.add_argument("state", nargs="?", choices=["on", "off"])
    wow64 = sub.add_parser("wow64", help=tr("WoW64 模式（默认开启，无需 32 位库）", "WoW64 mode (on by default; no 32-bit libraries needed)"))
    wow64.add_argument("state", nargs="?", choices=["on", "off"])
    logs = sub.add_parser("logs", help=tr("列出日志，开关 Proton 日志", "list the logs, turn the Proton log on or off"),
                          description=tr("不带参数列出日志文件。Proton 日志从下次启动 WeGame 开始记录。",
                                         "Without arguments, list the log files. The Proton log starts with the next WeGame start."))
    logs.add_argument("state", nargs="?", choices=["on", "off"], help=tr("Proton 日志", "Proton log"))
    logs.add_argument("--winedebug", metavar=tr("通道", "CHANNELS"),
                      help=tr("Proton 日志的 WINEDEBUG，空字符串表示 Proton 默认", "WINEDEBUG for the Proton log; empty for Proton's default"))
    runner = sub.add_parser("runner", help=tr("列出或选择 Proton", "list or choose the Proton"),
                            description=tr("不带参数列出电脑上找到的 Proton；auto 表示自动用最新的 DW-Proton。",
                                           "Without arguments, list the Protons found; auto picks the newest DW-Proton."))
    runner.add_argument("choice", nargs="?", metavar=tr("auto|名称|路径", "auto|NAME|PATH"))
    runner.add_argument("--download", action="store_true", help=tr("下载最新 DW-Proton", "download the latest DW-Proton"))
    # The .desktop file hands wegame:// links over as a bare argument.
    argv = sys.argv[1:]
    if argv and argv[0].lower().startswith("wegame:"):
        if not is_installed():
            return run_gui()  # don't start a silent multi-hundred-MB install from a link
        argv = ["run", *argv]
    options = parser.parse_args(argv)

    if options.command is None:
        return run_gui()
    try:
        if options.command == "install":
            install(cli_progress())
        elif options.command == "run":
            if not is_installed():
                install(cli_progress())
            return run_supervised(options.args, lambda message: print(message, file=sys.stderr))
        elif options.command == "kill":
            count = kill_all()
            print(tr(f"已结束 {count} 个进程", f"Killed {count} processes"))
        elif options.command == "reinstall":
            reinstall(cli_progress())
        elif options.command == "rebuild":
            rebuild(cli_progress())
        elif options.command == "gamescope":
            changes = {}
            if options.state:
                changes["enabled"] = options.state == "on"
            if options.fullscreen:
                changes["fullscreen"] = options.fullscreen == "on"
            if options.fsr:
                changes["fsr"] = options.fsr == "on"
            for key in ("res", "fps", "args"):
                value = getattr(options, key)
                if value is not None:
                    changes["resolution" if key == "res" else key] = value
            if changes.get("resolution") and not re.fullmatch(r"\d+x\d+", changes["resolution"]):
                raise LauncherError(tr(f"分辨率格式应为 宽x高：{changes['resolution']}", f"Resolution must be WxH: {changes['resolution']}"))
            if changes.get("fps") and not str(changes["fps"]).isdigit():
                raise LauncherError(tr(f"帧率应为整数：{changes['fps']}", f"Frame limit must be a number: {changes['fps']}"))
            if changes:
                set_gamescope(**changes)
            for key, value in gamescope_settings().items():
                print(f"{key:<11} {value}")
            if gamescope_settings()["enabled"]:
                print("command    ", shlex.join(gamescope_command()))
        elif options.command == "mangohud":
            if options.state:
                save_config(mangohud=options.state == "on")
            print("mangohud", "on" if load_config().get("mangohud") else "off")
        elif options.command == "wow64":
            if options.state:
                save_config(wow64=options.state == "on")
            print("wow64", "on" if load_config().get("wow64", True) else "off")
        elif options.command == "logs":
            if options.state:
                save_config(proton_log=options.state == "on")
            if options.winedebug is not None:
                save_config(winedebug=options.winedebug.strip())
            config = load_config()
            print("proton-log", "on" if config.get("proton_log") else "off")
            print("winedebug ", config.get("winedebug") or tr("（Proton 默认）", "(Proton default)"))
            for path, title in log_files():
                stat = path.stat()
                print(f"{human_size(stat.st_size):>10}  {datetime.fromtimestamp(stat.st_mtime):%m-%d %H:%M}  {path}  {title}")
        elif options.command == "runner":
            if options.download:
                download_dwproton(cli_progress())
                save_config(runner=None)
            elif options.choice:
                choose_runner(options.choice)
            picked = current_runner()
            for label, path in find_runners().items():
                print(f"{'*' if path == picked else ' '} {label:<28} {path}")
            if not load_config().get("runner"):
                print(tr("（自动：使用最新的 DW-Proton）", "(auto: newest DW-Proton)"))
        elif options.command == "status":
            print(f"root:    {ROOT}")
            proton = current_runner()
            print(f"runner:  {runner_name()} ({proton or '-'})")
            print(f"wegame:  {client_version() or '-'}")
            print(f"running: {', '.join(map(str, prefix_pids())) or '-'}")
            print(f"logs:    {LOGS}")
    except LauncherError as exc:
        print(f"wegame-launcher: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
