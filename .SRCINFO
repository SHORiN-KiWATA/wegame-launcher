pkgbase = wegame-launcher
	pkgdesc = Standalone launcher that installs and runs Tencent WeGame with Proton (unofficial)
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/SHORiN-KiWATA/wegame-launcher
	arch = x86_64
	license = GPL-3.0-only
	depends = python>=3.12
	depends = python-gobject
	depends = gtk4
	depends = freetype2
	depends = fontconfig
	depends = gnutls
	depends = libx11
	depends = libxext
	depends = libxrandr
	depends = libxi
	depends = libxcursor
	depends = libxcomposite
	depends = libxinerama
	depends = libxrender
	depends = libxxf86vm
	depends = vulkan-icd-loader
	depends = libpulse
	optdepends = vulkan-driver: DXVK rendering (WeGame does not start without Vulkan)
	optdepends = dwproton-bin: use a system-wide DW-Proton instead of downloading one
	optdepends = 7zip: use the system 7z instead of downloading 7-Zip
	optdepends = gamescope: run WeGame nested in its own compositor
	optdepends = mangohud: performance overlay
	optdepends = xdg-utils: open the prefix folder
	source = wegame-launcher-0.1.0.tar.gz::https://github.com/SHORiN-KiWATA/wegame-launcher/archive/refs/tags/v0.1.0.tar.gz
	sha256sums = SKIP

pkgname = wegame-launcher
